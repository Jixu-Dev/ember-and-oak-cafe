# Ember & Oak — Environment Variables
# Copy this file to .env and fill in your values

# Express server port (default: 3001)
PORT=3001

# SMTP settings for Nodemailer (email notifications)
# For development, use Ethereal: https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass

# Email address to receive contact form notifications
NOTIFY_EMAIL=hello@emberandoak.coffee
